---
import { t } from '../../i18n';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-top mt-auto">
  <div class="container d-flex align-items-center justify-content-between py-4 text-body-secondary small">
    <span>&copy; {year} WPMoo</span>
    <div class="d-flex gap-3">
      <a href="https://ui.wpmoo.org" class="text-decoration-none text-body-secondary" target="_blank" rel="noopener">
        Moo UI
      </a>
      <a href="https://github.com/wpmoo-org" class="text-decoration-none text-body-secondary" target="_blank" rel="noopener">
        GitHub
      </a>
    </div>
  </div>
</footer>
