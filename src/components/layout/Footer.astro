---
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const year = new Date().getFullYear();
const builtWith = lang === 'tr' ? 'Moo UI ile üretildi' : lang === 'de' ? 'Mit Moo UI erstellt' : 'Built with Moo UI';
---

<footer class="mt-auto" data-site-footer>
  <div class="container site-container d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 py-4 text-body-secondary small">
    <span>&copy; {year} cangir.de</span>
    <div class="d-flex flex-wrap align-items-center gap-3">
      <a href="https://ui.wpmoo.org" class="text-body-secondary text-decoration-none py-1" target="_blank" rel="noopener">
        {builtWith}
      </a>
      <a href="https://github.com/cangir" class="text-body-secondary text-decoration-none py-1" target="_blank" rel="noopener">
        GitHub
      </a>
    </div>
  </div>
</footer>
