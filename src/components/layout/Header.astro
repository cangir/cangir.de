---
import { t } from '../../i18n';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
---

<header class="moo-doc-header">
  <nav class="navbar" aria-label="Site navigation">
    <div class="moo-doc-container moo-doc-navbar-inner">
      <div class="moo-doc-header-start">
        <div class="nav moo-doc-header-nav d-flex">
          <a href={lang === 'en' ? '/' : `/${lang}/`} class="nav-link">
            Home
          </a>
          <a href={lang === 'en' ? '/blog/' : `/${lang}/blog/`} class="nav-link">
            {t(lang, 'nav.blog')}
          </a>
          <a href="https://ui.wpmoo.org" class="nav-link" target="_blank" rel="noopener">
            Moo UI
          </a>
        </div>
      </div>

      <div class="moo-doc-header-actions">
        <button
          type="button"
          class="btn btn-ghost moo-doc-search-trigger"
          aria-label="Search"
          data-bs-toggle="modal"
          data-bs-target="#doc-search"
        >
          <span class="moo-doc-search-trigger-lead">
            <svg data-icon="inline-start" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21l-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
            <span class="d-none d-sm-inline">Search</span>
          </span>
          <span class="moo-doc-search-trigger-shortcut d-none d-md-inline-flex"><kbd>⌘</kbd><kbd>K</kbd></span>
        </button>
        <button
          type="button"
          class="btn btn-ghost btn-icon moo-doc-theme-toggle"
          id="theme-toggle"
          aria-label="Toggle theme"
        >
          <svg class="d-none" data-theme-icon="light" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          <svg class="d-none" data-theme-icon="dark" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>
        <a
          class="btn btn-primary moo-doc-github-link"
          role="button"
          href="https://github.com/cangir"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open GitHub profile"
        >
          <svg viewBox="0 0 438.549 438.549" fill="currentColor" aria-hidden="true">
            <path d="M409.132 114.573c-19.608-33.596-46.205-60.194-79.798-79.8-33.598-19.607-70.277-29.408-110.063-29.408-39.781 0-76.472 9.804-110.063 29.408-33.596 19.605-60.192 46.204-79.8 79.8C9.803 148.168 0 184.854 0 224.63c0 47.78 13.94 90.745 41.827 128.906 27.884 38.164 63.906 64.572 108.063 79.227 5.14.954 8.945.283 11.419-1.996 2.475-2.282 3.711-5.14 3.711-8.562 0-.571-.049-5.708-.144-15.417a2549.81 2549.81 0 01-.144-25.406l-6.567 1.136c-4.187.767-9.469 1.092-15.846 1-6.374-.089-12.991-.757-19.842-1.999-6.854-1.231-13.229-4.086-19.13-8.559-5.898-4.473-10.085-10.328-12.56-17.556l-2.855-6.57c-1.903-4.374-4.899-9.233-8.992-14.559-4.093-5.331-8.232-8.945-12.419-10.848l-1.999-1.431c-1.332-.951-2.568-2.098-3.711-3.429-1.142-1.331-1.997-2.663-2.568-3.997-.572-1.335-.098-2.43 1.427-3.289 1.525-.859 4.281-1.276 8.28-1.276l5.708.853c3.807.763 8.516 3.042 14.133 6.851 5.614 3.806 10.229 8.754 13.846 14.842 4.38 7.806 9.657 13.754 15.846 17.847 6.184 4.093 12.419 6.136 18.699 6.136 6.28 0 11.704-.476 16.274-1.423 4.565-.952 8.848-2.383 12.847-4.285 1.713-12.758 6.377-22.559 13.988-29.41-10.848-1.14-20.601-2.857-29.264-5.14-8.658-2.286-17.605-5.996-26.835-11.14-9.235-5.137-16.896-11.516-22.985-19.126-6.09-7.614-11.088-17.61-14.987-29.979-3.901-12.374-5.852-26.648-5.852-42.826 0-23.035 7.52-42.637 22.557-58.817-7.044-17.318-6.379-36.732 1.997-58.24 5.52-1.715 13.706-.428 24.554 3.853 10.85 4.283 18.794 7.952 23.84 10.994 5.046 3.041 9.089 5.618 12.135 7.708 17.705-4.947 35.976-7.421 54.818-7.421s37.117 2.474 54.823 7.421l10.849-6.849c7.419-4.57 16.18-8.758 26.262-12.565 10.088-3.805 17.802-4.853 23.134-3.138 8.562 21.509 9.325 40.922 2.279 58.24 15.036 16.18 22.559 35.787 22.559 58.817 0 16.178-1.958 30.497-5.853 42.966-3.9 12.471-8.941 22.457-15.125 29.979-6.191 7.521-13.901 13.85-23.131 18.986-9.232 5.14-18.182 8.85-26.84 11.136-8.662 2.286-18.415 4.004-29.263 5.146 9.894 8.562 14.842 22.077 14.842 40.539v60.237c0 3.422 1.19 6.279 3.572 8.562 2.379 2.279 6.136 2.95 11.276 1.995 44.163-14.653 80.185-41.062 108.068-79.226 27.88-38.161 41.825-81.126 41.825-128.906-.01-39.771-9.818-76.454-29.414-110.049z"/>
          </svg>
          <span class="d-none d-lg-inline">cangir</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<div class="modal fade moo-doc-search" id="doc-search" tabindex="-1" aria-labelledby="doc-search-title">
  <div class="modal-dialog moo-doc-search-dialog">
    <div class="modal-content moo-doc-search-content">
      <div class="modal-header moo-doc-search-header">
        <h2 class="visually-hidden" id="doc-search-title">Search</h2>
        <div class="input-group moo-doc-search-input-group">
          <span class="input-group-text">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21l-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
          </span>
          <input type="search" class="form-control" placeholder="Search..." aria-label="Search" id="doc-search-input" autocomplete="off" />
        </div>
      </div>
      <div class="modal-body moo-doc-search-body">
        <div class="list-group list-group-flush" id="doc-search-results"></div>
        <p class="moo-doc-search-empty text-body-secondary small" hidden>No matching pages.</p>
      </div>
      <div class="modal-footer moo-doc-search-footer">
        <kbd>↵</kbd>
        <span>Go to Page</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { Modal } from 'bootstrap';

  function updateIcon() {
    const isDark = document.documentElement.dataset.bsTheme === 'dark';
    document.querySelector('[data-theme-icon="light"]')?.classList.toggle('d-none', !isDark);
    document.querySelector('[data-theme-icon="dark"]')?.classList.toggle('d-none', isDark);
  }

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.dataset.bsTheme === 'dark';
    const next = isDark ? 'light' : 'dark';
    document.documentElement.dataset.bsTheme = next;
    localStorage.setItem('wpmoo:theme', next);
    updateIcon();
  });

  updateIcon();

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      const modal = document.getElementById('doc-search');
      if (modal) {
        Modal.getOrCreateInstance(modal).toggle();
      }
    }
  });

  interface SearchEntry {
    title: string;
    description: string;
    href: string;
    tags: string[];
  }

  let searchIndex: SearchEntry[] = [];
  let searchLoaded = false;

  const searchModal = document.getElementById('doc-search');
  const searchInput = document.getElementById('doc-search-input') as HTMLInputElement | null;
  const searchResults = document.getElementById('doc-search-results');
  const searchEmpty = document.querySelector('.moo-doc-search-empty') as HTMLElement | null;

  async function loadIndex() {
    if (searchLoaded) return;
    try {
      const res = await fetch('/search-index.json');
      searchIndex = await res.json();
      searchLoaded = true;
    } catch (_) {}
  }

  function renderResults(query: string) {
    if (!searchResults) return;
    const q = query.toLowerCase().trim();
    const matches = q
      ? searchIndex.filter(
          (e) =>
            e.title.toLowerCase().includes(q) ||
            e.description.toLowerCase().includes(q) ||
            e.tags.some((t) => t.toLowerCase().includes(q))
        )
      : searchIndex;

    searchResults.innerHTML = matches
      .map(
        (e) =>
          `<a class="moo-doc-search-item" href="${e.href}"><span>${e.title}</span></a>`
      )
      .join('');

    if (searchEmpty) searchEmpty.hidden = matches.length > 0;
  }

  searchModal?.addEventListener('shown.bs.modal', async () => {
    searchInput?.focus();
    await loadIndex();
    renderResults('');
  });

  searchInput?.addEventListener('input', () => {
    renderResults(searchInput.value);
  });

  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const first = searchResults?.querySelector('.moo-doc-search-item') as HTMLAnchorElement | null;
      if (first) window.location.href = first.href;
    }
  });
</script>
