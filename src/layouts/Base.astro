---
import '@wpmoo/ui/moo-ui.css';
import '@fontsource/geist-sans/latin-400.css';
import '@fontsource/geist-sans/latin-500.css';
import '@fontsource/geist-sans/latin-600.css';
import '@fontsource/geist-sans/latin-700.css';
import '@fontsource/geist-mono/latin-400.css';
import '../styles/site.scss';

interface AlternateLink {
  lang: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  cover?: string;
  pageType?: 'website' | 'article';
  publishedTime?: string;
  alternates?: AlternateLink[];
}

const {
  title = 'cangir.de',
  description = 'Ahmet Cangir — development blog and project showcase.',
  lang = 'en',
  cover,
  pageType = 'website',
  publishedTime,
  alternates = [],
} = Astro.props;

const skipLabels: Record<string, string> = {
  en: 'Skip to content',
  de: 'Zum Inhalt springen',
  tr: 'İçeriğe geç',
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = cover ? new URL(cover, Astro.site) : new URL('/avatar.jpg', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site).href} />
    ))}
    <link rel="icon" type="image/jpeg" href="/avatar.jpg" />
    <meta property="og:type" content={pageType} />
    {pageType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('cangir:theme');
          const theme = savedTheme === 'dark' || savedTheme === 'light'
            ? savedTheme
            : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.bsTheme = theme;
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="page-grid-bg d-flex flex-column min-vh-100 bg-body text-body">
    <a href="#main-content" class="visually-hidden-focusable position-fixed top-0 start-0 z-3 m-3 btn btn-primary">
      {skipLabels[lang] ?? skipLabels.en}
    </a>
    <slot />
  </body>
</html>
