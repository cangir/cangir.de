---
import '@wpmoo/ui/moo-ui.css';
import '../styles/doc.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  cover?: string;
}

const {
  title = 'cangir.de',
  description = 'Ahmet Cangir — development blog and project showcase.',
  lang = 'en',
  cover,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = cover ? new URL(cover, Astro.site) : new URL('/avatar.jpg', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/jpeg" href="/avatar.jpg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('wpmoo:theme');
          if (theme === 'dark' || theme === 'light') {
            document.documentElement.dataset.bsTheme = theme;
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="d-flex flex-column min-vh-100 bg-body text-body">
    <slot />
    <script>
      import 'bootstrap/dist/js/bootstrap.bundle.min.js';
    </script>
  </body>
</html>
