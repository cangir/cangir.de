---
import Base from '../../layouts/Base.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

const lang = 'tr';
const alternates = [
  { lang: 'en', href: '/' },
  { lang: 'de', href: '/de/' },
  { lang: 'tr', href: '/tr/' },
];
---

<Base title="Ahmet Cangir — Geliştirme notları ve açık kaynak projeleri" lang={lang} alternates={alternates}>
  <Header lang={lang} />
  <main id="main-content" class="container site-content flex-grow-1 py-5" tabindex="-1">
    <section class="row align-items-center gy-4 gy-lg-5 py-lg-5 mb-5" aria-labelledby="home-title">
      <div class="col-12 col-lg-6 d-flex justify-content-center justify-content-lg-start">
        <div class="col-8 col-sm-6 col-lg-12">
          <img src="/avatar.webp" alt="Ahmet Cangir" width="280" height="280" class="rounded-circle img-fluid" />
        </div>
      </div>
      <div class="col-12 col-lg-6">
        <p class="text-body-secondary small text-uppercase fw-semibold mb-2">Geliştirici · Üretici · Yazar</p>
        <h1 class="display-4 fw-bold mb-3" id="home-title">Ahmet Cangir</h1>
        <p class="lead text-body-secondary mb-4">
          Odoo uygulamalarından Bootstrap-native arayüzlere kadar daha sakin geliştirme
          akışları için araçlar üretiyorum.
        </p>
        <div class="d-flex flex-wrap gap-2">
          <a href="/tr/blog/" class="btn btn-primary px-3">Blogu oku</a>
          <a href="https://ui.wpmoo.org" class="btn btn-outline-secondary px-3" target="_blank" rel="noopener">
            Moo UI’yi incele
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="explore-title">
      <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-2 mb-4">
        <div>
          <p class="text-body-secondary small text-uppercase fw-semibold mb-2">Keşfet</p>
          <h2 class="h3 mb-0" id="explore-title">Notlar, bileşenler ve deneyler</h2>
        </div>
        <span class="badge border text-body-secondary align-self-start align-self-md-auto">Moo UI ile üretildi</span>
      </div>

      <div class="row g-4">
        <div class="col-12 col-md-4">
          <article class="card h-100">
            <div class="card-body d-flex flex-column gap-3 p-3 p-lg-4">
              <span class="d-inline-flex align-items-center justify-content-center align-self-start rounded-3 bg-body-tertiary border p-2" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"></path>
                </svg>
              </span>
              <div>
                <h3 class="h6 mb-2">Geliştirme notları</h3>
                <p class="text-body-secondary mb-0">Gerçek projelerden nelerin çalıştığına, nelerin bozulduğuna ve öğrendiklerime dair yazılar.</p>
              </div>
              <a href="/tr/blog/" class="fw-medium text-body text-decoration-none stretched-link mt-auto">Son yazıları oku →</a>
            </div>
          </article>
        </div>

        <div class="col-12 col-md-4">
          <article class="card h-100">
            <div class="card-body d-flex flex-column gap-3 p-3 p-lg-4">
              <span class="d-inline-flex align-items-center justify-content-center align-self-start rounded-3 bg-body-tertiary border p-2" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="7" height="9" x="3" y="3" rx="1"></rect><rect width="7" height="5" x="14" y="3" rx="1"></rect><rect width="7" height="9" x="14" y="12" rx="1"></rect><rect width="7" height="5" x="3" y="16" rx="1"></rect>
                </svg>
              </span>
              <div>
                <h3 class="h6 mb-2">Moo UI</h3>
                <p class="text-body-secondary mb-0">Bootstrap markup. shadcn feel. Server-rendered uygulamalar için bir bileşen sistemi.</p>
              </div>
              <a href="https://ui.wpmoo.org" class="fw-medium text-body text-decoration-none stretched-link mt-auto" target="_blank" rel="noopener">Bileşenleri incele →</a>
            </div>
          </article>
        </div>

        <div class="col-12 col-md-4">
          <article class="card h-100">
            <div class="card-body d-flex flex-column gap-3 p-3 p-lg-4">
              <span class="d-inline-flex align-items-center justify-content-center align-self-start rounded-3 bg-body-tertiary border p-2" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-7 0C4.8.1 3.7.5 3.7.5A5 5 0 0 0 3.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 8 18v4"></path><path d="M8 19c-3 .9-3-1.5-4-2"></path>
                </svg>
              </span>
              <div>
                <h3 class="h6 mb-2">Açık kaynak</h3>
                <p class="text-body-secondary mb-0">Kod, küçük deneyler ve zaman zaman derinleşen teknik araştırmalar.</p>
              </div>
              <a href="https://github.com/cangir" class="fw-medium text-body text-decoration-none stretched-link mt-auto" target="_blank" rel="noopener">Projeleri gör →</a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
