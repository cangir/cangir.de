---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { t } from '../i18n';

const lang = 'en';
---

<Base title="WPMoo" lang={lang}>
  <Header lang={lang} />
  <main class="container d-flex flex-column align-items-center justify-content-center flex-grow-1 py-5">
    <div class="text-center mb-5">
      <img src="/wpmoo-logo.webp" alt="WPMoo" width="64" height="64" class="mb-3" />
      <h1 class="display-4 fw-bold mb-2">WPMoo</h1>
      <p class="fs-5 text-body-secondary">{t(lang, 'home.tagline')}</p>
    </div>
    <div class="row g-4 w-100" style="max-width: 720px;">
      <div class="col-12 col-md-4">
        <a href="/blog/" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h6 fw-semibold mb-1">{t(lang, 'home.blog.title')}</h2>
            <p class="small text-body-secondary mb-0">{t(lang, 'home.blog.description')}</p>
          </div>
        </a>
      </div>
      <div class="col-12 col-md-4">
        <a href="https://ui.wpmoo.org" class="card text-decoration-none h-100" target="_blank" rel="noopener">
          <div class="card-body">
            <h2 class="h6 fw-semibold mb-1">{t(lang, 'home.ui.title')}</h2>
            <p class="small text-body-secondary mb-0">{t(lang, 'home.ui.description')}</p>
          </div>
        </a>
      </div>
      <div class="col-12 col-md-4">
        <a href="https://github.com/wpmoo-org" class="card text-decoration-none h-100" target="_blank" rel="noopener">
          <div class="card-body">
            <h2 class="h6 fw-semibold mb-1">{t(lang, 'home.github.title')}</h2>
            <p class="small text-body-secondary mb-0">{t(lang, 'home.github.description')}</p>
          </div>
        </a>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Base>
