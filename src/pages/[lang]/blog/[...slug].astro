---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';

const supportedLocales = ['de', 'tr'] as const;
type SupportedLocale = (typeof supportedLocales)[number];

const copy = {
  de: {
    onThisPage: 'Auf dieser Seite',
    allArticles: 'Alle Artikel',
    minuteRead: 'Min. Lesezeit',
    share: 'Artikel teilen',
    copyLink: 'Link kopieren',
    copyCode: 'Code kopieren',
    copied: 'Kopiert!',
    codeCopied: 'Code in die Zwischenablage kopiert.',
    failed: 'Kopieren fehlgeschlagen',
    writtenBy: 'Geschrieben von',
    continueReading: 'Weiterlesen',
    relatedArticles: 'Ähnliche Artikel',
    articleTags: 'Artikel-Tags',
    closeNotification: 'Benachrichtigung schließen',
    bio: 'Ich entwickle Werkzeuge für ruhigere Entwicklungsabläufe – von Odoo-Anwendungen bis zu Bootstrap-nativen Benutzeroberflächen.',
  },
  tr: {
    onThisPage: 'Bu yazıda',
    allArticles: 'Tüm yazılar',
    minuteRead: 'dk. okuma',
    share: 'Yazıyı paylaş',
    copyLink: 'Bağlantıyı kopyala',
    copyCode: 'Kodu kopyala',
    copied: 'Kopyalandı!',
    codeCopied: 'Kod panoya kopyalandı.',
    failed: 'Kopyalanamadı',
    writtenBy: 'Yazan',
    continueReading: 'Okumaya devam et',
    relatedArticles: 'İlgili yazılar',
    articleTags: 'Yazı etiketleri',
    closeNotification: 'Bildirimi kapat',
    bio: 'Odoo uygulamalarından Bootstrap-native arayüzlere kadar daha sakin geliştirme akışları için araçlar üretiyorum.',
  },
};

export async function getStaticPaths() {
  const locales = ['de', 'tr'] as const;
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const posts = allPosts.filter(({ id }) => locales.some((locale) => id.startsWith(`${locale}/`)));

  return posts.map((post) => {
    const lang = post.id.split('/')[0] as SupportedLocale;
    const slug = post.id.replace(new RegExp(`^${lang}/`), '').replace(/\/$/, '');
    const postTags = new Set(post.data.tags);
    const relatedPosts = posts
      .filter((candidate) =>
        candidate.id !== post.id &&
        candidate.id.startsWith(`${lang}/`) &&
        candidate.data.tags.some((tag) => postTags.has(tag))
      )
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
      .slice(0, 3);
    const languageLinks = Object.fromEntries(
      (['en', 'de', 'tr'] as const)
        .filter((locale) => allPosts.some((candidate) => candidate.id.replace(/\/$/, '') === `${locale}/${slug}`))
        .map((locale) => [locale, locale === 'en' ? `/blog/${slug}/` : `/${locale}/blog/${slug}/`]),
    );
    const alternates = Object.entries(languageLinks).map(([locale, href]) => ({ lang: locale, href }));
    return {
      params: { lang, slug },
      props: { post, lang, relatedPosts, languageLinks, alternates },
    };
  });
}

const { post, lang, relatedPosts, languageLinks, alternates } = Astro.props as {
  post: any;
  lang: SupportedLocale;
  relatedPosts: any[];
  languageLinks: Partial<Record<'en' | 'de' | 'tr', string>>;
  alternates: { lang: string; href: string }[];
};
const { Content, headings } = await render(post);
const labels = copy[lang];
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const slug = post.id.replace(new RegExp(`^${lang}/`), '').replace(/\/$/, '');
const postUrl = `https://cangir.de/${lang}/blog/${slug}/`;
const dateLocale = lang === 'tr' ? 'tr-TR' : 'de-DE';
---

<Base title={`${post.data.title} — Ahmet Cangir`} description={post.data.description} lang={lang} cover={post.data.cover} pageType="article" publishedTime={post.data.pubDate.toISOString()} alternates={alternates}>
  <Header lang={lang} languageLinks={languageLinks} />
  <main id="main-content" class="container site-content flex-grow-1 py-4 py-lg-5" tabindex="-1">
    <a href={`/${lang}/blog/`} class="d-inline-flex align-items-center gap-2 small text-body-secondary text-decoration-none mb-5">
      <span aria-hidden="true">←</span> {labels.allArticles}
    </a>

    <header class="border-bottom divider-dashed pb-5 mb-5">
          {post.data.cover && (
            <div class="ratio ratio-21x9 overflow-hidden rounded-4 bg-body-tertiary mb-5">
              <img src={post.data.cover} alt="" class="w-100 h-100 object-fit-cover" />
            </div>
          )}

          <div class="d-flex flex-wrap align-items-center gap-2 text-body-secondary small mb-4">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <span aria-hidden="true">·</span>
            <span>{readingTime} {labels.minuteRead}</span>
          </div>

          <h1 class="display-6 fw-bold lh-sm mb-4">{post.data.title}</h1>
          <div class="row">
            <p class="lead text-body-secondary mb-4 col-12 col-lg-8">{post.data.description}</p>
          </div>

          <div class="d-flex flex-wrap gap-2" aria-label={labels.articleTags}>
            {post.data.tags.map((tag: string) => (
              <a href={`/${lang}/blog/tag/${encodeURIComponent(tag)}/`} class="badge border text-body-secondary text-decoration-none">{tag}</a>
            ))}
          </div>
    </header>

    {tocItems.length > 0 && (
      <section class="d-lg-none border rounded-3 mb-5" aria-labelledby="mobile-toc-title">
        <button type="button" class="btn btn-ghost w-100 d-flex align-items-center justify-content-between text-start p-3" id="mobile-toc-toggle" aria-expanded="false" aria-controls="mobile-toc">
          <span class="fw-semibold" id="mobile-toc-title">{labels.onThisPage}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>
        <div class="collapse" id="mobile-toc">
          <nav class="nav toc-nav flex-column border-top p-3" aria-label={labels.onThisPage}>
            {tocItems.map((item) => (
              <a class={`nav-link px-0 py-1 small text-body-secondary${item.depth === 3 ? ' ps-3' : ''}`} href={`#${item.slug}`}>
                {item.text}
              </a>
            ))}
          </nav>
        </div>
      </section>
    )}

    <div class="row g-0 g-lg-5">
      <article class="col-12 col-lg-8">
        <div class="fs-5 lh-base article-body">
          <Content />
        </div>

        {relatedPosts.length > 0 && (
          <section class="border-top mt-5 pt-5" aria-labelledby="related-articles-title">
            <p class="text-body-secondary small text-uppercase fw-semibold mb-2">{labels.continueReading}</p>
            <h2 class="h3 mb-4" id="related-articles-title">{labels.relatedArticles}</h2>
            <div class="row g-3">
              {relatedPosts.map((relatedPost) => {
                const relatedSlug = relatedPost.id.replace(new RegExp(`^${lang}/`), '').replace(/\/$/, '');
                return (
                  <div class="col-12 col-md-6">
                    <article class="card h-100 position-relative">
                      <div class="card-body p-4">
                        <time class="small text-body-secondary" datetime={relatedPost.data.pubDate.toISOString()}>
                          {relatedPost.data.pubDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' })}
                        </time>
                        <h3 class="h5 mt-3 mb-2"><a href={`/${lang}/blog/${relatedSlug}/`} class="text-body text-decoration-none stretched-link">{relatedPost.data.title}</a></h3>
                        <p class="small text-body-secondary mb-0">{relatedPost.data.description}</p>
                      </div>
                    </article>
                  </div>
                );
              })}
            </div>
          </section>
        )}

        <footer class="border-top mt-5 pt-5">
          <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 pb-5">
            <span class="fw-semibold">{labels.share}</span>
            <div class="d-flex flex-wrap gap-2">
              <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(post.data.title)}`} class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener">Twitter</a>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`} class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener">LinkedIn</a>
              <button type="button" class="btn btn-outline-secondary btn-sm" id="copy-link" data-copy-label={labels.copyLink} data-copied-label={labels.copied} data-failed-label={labels.failed}>{labels.copyLink}</button>
            </div>
          </div>

          <div class="border-top py-5">
            <div class="d-flex flex-column flex-sm-row align-items-center text-center text-sm-start gap-4">
              <img src="/avatar.webp" alt="Ahmet Cangir" width="72" height="72" class="rounded-circle flex-shrink-0" />
              <div>
                <p class="text-body-secondary small text-uppercase fw-semibold mb-1">{labels.writtenBy}</p>
                <h2 class="h4 mb-2">Ahmet Cangir</h2>
                <p class="text-body-secondary mb-3">{labels.bio}</p>
                <div class="d-flex justify-content-center justify-content-sm-start gap-3 small">
                  <a href="https://github.com/cangir" class="text-body fw-medium text-decoration-none" target="_blank" rel="noopener">GitHub ↗</a>
                  <a href="https://ui.wpmoo.org" class="text-body fw-medium text-decoration-none" target="_blank" rel="noopener">Moo UI ↗</a>
                </div>
              </div>
            </div>
          </div>
        </footer>
      </article>

      {tocItems.length > 0 && (
        <aside class="d-none d-lg-block col-lg-3" aria-label={labels.onThisPage}>
          <div class="article-toc-sticky border-start divider-dashed ps-4 py-2">
            <h2 class="h6 mb-3">{labels.onThisPage}</h2>
            <nav class="nav toc-nav flex-column">
              {tocItems.map((item) => (
                <a class={`nav-link px-0 py-1 small text-body-secondary${item.depth === 3 ? ' ps-3' : ''}`} href={`#${item.slug}`}>
                  {item.text}
                </a>
              ))}
            </nav>
          </div>
        </aside>
      )}
    </div>
  </main>

  <div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div class="toast" id="copy-toast" role="status" aria-live="polite" aria-atomic="true" data-success-message={labels.copied} data-code-success-message={labels.codeCopied} data-copy-code-label={labels.copyCode} data-failed-message={labels.failed}>
      <div class="toast-body d-flex align-items-center gap-3">
        <span class="me-auto" data-toast-message>{labels.copied}</span>
        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label={labels.closeNotification}></button>
      </div>
    </div>
  </div>

  <Footer lang={lang} />
</Base>

<script>
  import { Collapse, Toast } from 'bootstrap';

  const mobileTocToggle = document.getElementById('mobile-toc-toggle');
  const mobileTocElement = document.getElementById('mobile-toc');
  if (mobileTocToggle && mobileTocElement) {
    const mobileToc = Collapse.getOrCreateInstance(mobileTocElement, { toggle: false });
    mobileTocToggle.addEventListener('click', () => {
      const willShow = mobileTocToggle.getAttribute('aria-expanded') !== 'true';
      mobileTocToggle.setAttribute('aria-expanded', String(willShow));
      willShow ? mobileToc.show() : mobileToc.hide();
    });
    mobileTocElement.addEventListener('shown.bs.collapse', () => mobileTocToggle.setAttribute('aria-expanded', 'true'));
    mobileTocElement.addEventListener('hidden.bs.collapse', () => mobileTocToggle.setAttribute('aria-expanded', 'false'));
    mobileTocElement.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => mobileToc.hide()));
  }

  // Highlight whichever section heading is currently in view by toggling
  // the same two Bootstrap text utilities already used elsewhere on this
  // template (text-body-secondary for muted, text-body for the base
  // reading color) on every matching TOC link — both the mobile and
  // desktop .toc-nav share the same #<slug> hrefs, so one querySelectorAll
  // updates both. No new CSS class or color.
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-nav .nav-link');
  const tocHeadings = Array.from(tocLinks, (link) => document.getElementById(link.getAttribute('href')?.slice(1) ?? ''))
    .filter((heading): heading is HTMLElement => heading !== null);

  const setActiveHeading = (id: string | null) => {
    tocLinks.forEach((link) => {
      const isActive = id !== null && link.getAttribute('href') === `#${id}`;
      link.classList.toggle('text-body', isActive);
      link.classList.toggle('text-body-secondary', !isActive);
      link.classList.toggle('fw-semibold', isActive);
      if (isActive) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  if (tocHeadings.length > 0) {
    const headingObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting);
        if (visible.length === 0) return;
        const topmost = visible.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        setActiveHeading(topmost.target.id);
      },
      { rootMargin: '0px 0px -70% 0px', threshold: 0 },
    );
    tocHeadings.forEach((heading) => headingObserver.observe(heading));
  }

  const copyButton = document.getElementById('copy-link');
  const toastElement = document.getElementById('copy-toast');
  const toastMessage = toastElement?.querySelector('[data-toast-message]');
  const copyToast = toastElement ? Toast.getOrCreateInstance(toastElement, { delay: 3000 }) : null;

  copyButton?.addEventListener('click', async () => {
    if (!toastElement || !toastMessage || !copyToast) return;
    try {
      await navigator.clipboard.writeText(window.location.href);
      toastMessage.textContent = toastElement.dataset.successMessage ?? 'Copied!';
    } catch (_) {
      toastMessage.textContent = toastElement.dataset.failedMessage ?? 'Copy failed';
    }
    copyToast.show();
  });

  document.querySelectorAll<HTMLPreElement>('.fs-5 pre[data-language]').forEach((pre) => {
    const language = pre.dataset.language ?? 'code';
    const wrapper = document.createElement('div');
    wrapper.className = 'card p-0 gap-0 overflow-hidden mb-4';
    const toolbar = document.createElement('div');
    toolbar.className = 'card-header d-flex flex-row align-items-center justify-content-between gap-3 py-2';
    const label = document.createElement('span');
    label.className = 'badge border text-body-secondary text-uppercase uppercase-tracked';
    label.textContent = language;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'btn btn-ghost btn-sm';
    button.textContent = toastElement?.dataset.copyCodeLabel ?? 'Copy code';
    button.setAttribute('aria-label', `${button.textContent}: ${language}`);
    toolbar.append(label, button);
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.append(toolbar, pre);
    pre.classList.add('card-body', 'm-0', 'p-3', 'rounded-0', 'fs-6', 'scroll-fade-x', 'no-scrollbar');
    button.addEventListener('click', async () => {
      if (!toastElement || !toastMessage || !copyToast) return;
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        toastMessage.textContent = toastElement.dataset.codeSuccessMessage ?? 'Code copied.';
      } catch (_) {
        toastMessage.textContent = toastElement.dataset.failedMessage ?? 'Copy failed';
      }
      copyToast.show();
    });
  });

  document.querySelectorAll<HTMLTableElement>('.fs-5 table').forEach((table) => {
    table.classList.add('table', 'table-bordered', 'align-middle');
    const wrapper = document.createElement('div');
    wrapper.className = 'table-responsive mb-4';
    table.parentNode?.insertBefore(wrapper, table);
    wrapper.append(table);
  });
</script>
