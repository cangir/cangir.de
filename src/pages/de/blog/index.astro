---
import BlogIndex from '../../../components/blog/BlogIndex.astro';
import { getLangPosts, getCategorySummary } from '../../../lib/blog';

const PAGE_SIZE = 6;
const posts = await getLangPosts('de');
const categories = getCategorySummary(posts);
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
---

<BlogIndex lang="de" posts={posts.slice(0, PAGE_SIZE)} currentPage={1} totalPages={totalPages} categories={categories} />
