---
import Base from '../../layouts/Base.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

const lang = 'de';
---

<Base title="Ahmet Cangir — Entwicklungsnotizen und Open-Source-Projekte" lang={lang}>
  <Header lang={lang} />
  <main class="container site-content flex-grow-1 py-5">
    <section class="row align-items-center gy-5 py-lg-5 mb-5" aria-labelledby="home-title">
      <div class="col-12 col-lg-6 d-flex justify-content-center justify-content-lg-start">
        <img src="/avatar.jpg" alt="Ahmet Cangir" width="280" height="280" class="rounded-circle" />
      </div>
      <div class="col-12 col-lg-6">
        <p class="text-body-secondary small text-uppercase fw-semibold mb-2">Entwickler · Builder · Autor</p>
        <h1 class="display-4 fw-semibold mb-3" id="home-title">Ahmet Cangir</h1>
        <p class="lead text-body-secondary mb-4">
          Ich entwickle Werkzeuge für ruhigere Entwicklungsabläufe – von Odoo-Anwendungen
          bis zu Bootstrap-nativen Benutzeroberflächen.
        </p>
        <div class="d-flex flex-wrap gap-2">
          <a href="/de/blog/" class="btn btn-primary px-3">Blog lesen</a>
          <a href="https://ui.wpmoo.org" class="btn btn-outline-secondary px-3" target="_blank" rel="noopener">
            Moo UI entdecken
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="explore-title">
      <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-2 mb-4">
        <div>
          <p class="text-body-secondary small text-uppercase fw-semibold mb-2">Entdecken</p>
          <h2 class="h3 mb-0" id="explore-title">Notizen, Komponenten und Experimente</h2>
        </div>
        <span class="badge border text-body-secondary align-self-start align-self-md-auto">Mit Moo UI erstellt</span>
      </div>

      <div class="row g-4">
        <div class="col-12 col-md-4">
          <article class="card h-100">
            <div class="card-body d-flex flex-column gap-3 p-4">
              <span class="d-inline-flex align-items-center justify-content-center align-self-start rounded-3 bg-body-tertiary border p-2" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"></path>
                </svg>
              </span>
              <div>
                <h3 class="h6 mb-2">Entwicklungsnotizen</h3>
                <p class="text-body-secondary mb-0">Notizen aus echten Projekten – was funktionierte, was kaputtging und was ich gelernt habe.</p>
              </div>
              <a href="/de/blog/" class="fw-medium text-body text-decoration-none stretched-link mt-auto">Aktuelle Beiträge lesen →</a>
            </div>
          </article>
        </div>

        <div class="col-12 col-md-4">
          <article class="card h-100">
            <div class="card-body d-flex flex-column gap-3 p-4">
              <span class="d-inline-flex align-items-center justify-content-center align-self-start rounded-3 bg-body-tertiary border p-2" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="7" height="9" x="3" y="3" rx="1"></rect><rect width="7" height="5" x="14" y="3" rx="1"></rect><rect width="7" height="9" x="14" y="12" rx="1"></rect><rect width="7" height="5" x="3" y="16" rx="1"></rect>
                </svg>
              </span>
              <div>
                <h3 class="h6 mb-2">Moo UI</h3>
                <p class="text-body-secondary mb-0">Bootstrap markup. shadcn feel. Ein Komponentensystem für serverseitig gerenderte Anwendungen.</p>
              </div>
              <a href="https://ui.wpmoo.org" class="fw-medium text-body text-decoration-none stretched-link mt-auto" target="_blank" rel="noopener">Komponenten ansehen →</a>
            </div>
          </article>
        </div>

        <div class="col-12 col-md-4">
          <article class="card h-100">
            <div class="card-body d-flex flex-column gap-3 p-4">
              <span class="d-inline-flex align-items-center justify-content-center align-self-start rounded-3 bg-body-tertiary border p-2" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-7 0C4.8.1 3.7.5 3.7.5A5 5 0 0 0 3.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 8 18v4"></path><path d="M8 19c-3 .9-3-1.5-4-2"></path>
                </svg>
              </span>
              <div>
                <h3 class="h6 mb-2">Open Source</h3>
                <p class="text-body-secondary mb-0">Code, kleine Experimente und gelegentliche technische Kaninchenlöcher.</p>
              </div>
              <a href="https://github.com/cangir" class="fw-medium text-body text-decoration-none stretched-link mt-auto" target="_blank" rel="noopener">Projekte ansehen →</a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
